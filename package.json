{
  "name": "tarabbusat",
  "productName": "انتقاء الحركية قصيرة المدى",
  "version": "1.1.0",
  "description": "تصنيف وتنقيط وترتيب ملفات الحركية قصيرة المدى في الخارج وفق القرار 345 المؤرخ في 09 مارس 2026",
  "main": "main.js",
  "author": "tarabbusat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dz.univ.tarabbusat",
    "artifactName": "tarabbusat-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "انتقاء التربصات",
      "artifactName": "tarabbusat-${version}-win-x64-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": null,
    "portable": {
      "artifactName": "tarabbusat-${version}-win-x64-portable.${ext}"
    }
  }
}
